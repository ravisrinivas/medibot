# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Where the MediAssist data folder lives (clinical/, nursing/, billing/, equipment/, general/, db/)
MEDIASSIST_DATA_DIR=./data/mediassist_data

# Local Qdrant storage path (file-based, no server needed for local dev)
QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=medibot_hybrid

# Models
GROQ_MODEL=openai/gpt-oss-20b
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
